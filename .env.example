# =============================================================================
# REQUIRED - Supabase Configuration
# =============================================================================

# Your Supabase project URL (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-side only, keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# OPTIONAL - Email Service (Resend)
# =============================================================================
# Get API key from https://resend.com

# RESEND_API_KEY=re_xxxxx
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# RESEND_FROM_NAME=My App

# =============================================================================
# OPTIONAL - Stripe Payments
# =============================================================================
# Get keys from https://dashboard.stripe.com/apikeys

# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# =============================================================================
# MONITORING - Sentry
# =============================================================================
# Get DSN from https://sentry.io - Project Settings > Client Keys

# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# =============================================================================
# APPLICATION
# =============================================================================

# Application URL (used for auth callbacks, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment (development, production, test)
NODE_ENV=development
